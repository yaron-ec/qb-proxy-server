# ─────────────────────────────────────────────────────────────────────────────
# Base44 Exit build environment.
# Loaded automatically by Vite when running with `--mode exit`
# (i.e. `npm run dev:exit` / `npm run build:exit`).
#
# This is the STANDALONE CRM frontend: no @base44/vite-plugin, no Base44 app
# params, no Base44 hosted login. Authentication is Railway-only.
# ─────────────────────────────────────────────────────────────────────────────

# Activates the Railway-only code paths in AuthContext / App (gated on this flag).
VITE_EXIT_BUILD=true

# Railway CRM API base URL. Set this to the deployed Railway API origin
# (e.g. https://crm-api.ecconstructiongroup.com). Left blank here so no
# production URL is hard-coded in source; the operator sets it per environment
# (copy this file to `.env.exit.local` and fill in the value).
VITE_RAILWAY_API_URL=