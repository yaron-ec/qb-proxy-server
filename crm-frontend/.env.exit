# Standalone exit build environment (loaded by Vite --mode exit)
# These are BUILD-TIME values injected into the static frontend bundle.
# No secrets here — VITE_* vars are public by design.
VITE_EXIT_BUILD=true
VITE_RAILWAY_API_URL=https://qb-proxy-server-production.up.railway.app
VITE_RAILWAY_CAPTURE_URL=https://qb-proxy-server-production.up.railway.app