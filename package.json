{
  "name": "qb-proxy-server",
  "version": "1.0.0",
  "description": "QuickBooks API proxy with static IP for Intuit Production whitelisting",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js test/*.test.cjs",
    "test:syntax": "for f in server.js reminderWorker.js reminderWatchdog.js productionWatchdog.js $(find routes lib db scripts -name '*.js'); do node -c \"$f\" || exit 1; done",
    "reminders:worker": "node reminderWorker.js",
    "reminders:watchdog": "node reminderWatchdog.js",
    "reminders:migrate": "node -e \"require('./db/client').ensureSchema().then(()=>{console.log('schema ok');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "reminders:seed": "node db/seedTestLeads.js",
    "reminders:import": "node db/importLeads.js",
    "validate:email-migration": "node validateEmailMigration.js",
    "email:test:phase1": "node testEmailOnce.js",
    "reminders:test:single": "node testSingleReminderLive.js",
    "gmail:oauth:test": "node --test test/gmailOAuth.test.js",
    "test:integration": "node --test test/integration/*.int.test.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "multer": "^1.4.5-lts.1",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "engines": {
    "node": ">=18"
  }
}
