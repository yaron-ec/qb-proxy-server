{
  "name": "qb-proxy-server",
  "version": "1.0.0",
  "description": "QuickBooks API proxy with static IP for Intuit Production whitelisting",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "reminders:worker": "node reminderWorker.js",
    "reminders:watchdog": "node reminderWatchdog.js",
    "reminders:migrate": "node -e \"require('./db/client').ensureSchema().then(()=>{console.log('schema ok');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "node-cron": "^3.0.3",
    "@base44/sdk": "^0.8.37",
    "pg": "^8.11.3"
  },
  "engines": {
    "node": ">=18"
  }
}
