+const BG = '#EEF1F7';
+const LIGHT = '#F4F6FA';
+const TEXT = '#1A1A2E';
+const MUTED = '#6B7280';
+
+function publicUrl() { return (process.env.REMINDER_PUBLIC_URL || '').replace(/\/$/, ''); }
+
+function esc(s) {
+  return String(s == null ? '' : s)
+    .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
+}
+
+const PAGE_CSS = `
+  *{margin:0;padding:0;box-sizing:border-box;}
