# ---- Build stage ----
# Builds the standalone CRM frontend from the isolated crm-frontend/ subdirectory.
# Does NOT use the backend root package.json — only crm-frontend/package.json.
FROM node:20-alpine AS build
WORKDIR /app
COPY crm-frontend/package.json ./
RUN npm install --no-audit --no-fund
COPY crm-frontend/ ./
ARG VITE_RAILWAY_API_URL=https://qb-proxy-server-production.up.railway.app
ENV VITE_RAILWAY_API_URL=$VITE_RAILWAY_API_URL
ARG VITE_RAILWAY_CAPTURE_URL=https://qb-proxy-server-production.up.railway.app
ENV VITE_RAILWAY_CAPTURE_URL=$VITE_RAILWAY_CAPTURE_URL
RUN npm run build:exit

# ---- Production SPA serve stage ----
FROM nginx:alpine
# Ensure envsubst is available (gettext provides it; some nginx:alpine tags omit it)
RUN apk add --no-cache gettext
ENV PORT=80
RUN rm -f /etc/nginx/conf.d/default.conf
COPY crm-frontend/nginx.conf /etc/nginx/conf.d/default.template
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
# Runtime: substitute ${PORT} in the template, validate config, then start nginx.
# Exec-form CMD passes the string directly to /bin/sh -c.
# Single quotes around ${PORT} prevent the shell from expanding it, so envsubst
# receives the literal variable NAME "PORT" and substitutes its value.
CMD ["/bin/sh", "-c", "export PORT=${PORT:-80} && envsubst '${PORT}' < /etc/nginx/conf.d/default.template > /etc/nginx/conf.d/default.conf && nginx -t && exec nginx -g 'daemon off;'"]
